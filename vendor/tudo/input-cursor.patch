+struct EditorGlyph<'a> {
+    row: usize,
+    column: usize,
+    width: usize,
+    symbol: &'a str,
+    style: Style,
+}
+
+/// Lay out the glyphs and insertion point together in terminal cells.
+/// Multi-line fields wrap at glyph boundaries; single-line fields scroll.
+fn render_editor_text(
+    f: &mut Frame,
+    area: Rect,
+    input: &InputState,
+    style_line: impl Fn(&str) -> Line<'static>,
+) {
+    if area.is_empty() {
+        return;
+    }
+    let width = usize::from(area.width);
+    let height = if input.multiline {
+        usize::from(area.height)
+    } else {
+        1
+    };
+    let cursor_byte = input.byte_at(input.cursor);
+    let (mut cursor_row, mut cursor_col) = (0, 0);
+    let mut cursor_line_width = 0;
+    let mut glyphs = Vec::new();
+    let (mut line_byte, mut row) = (0, 0);
+
+    for source in input.buffer.split('\n') {
+        let mut column = 0;
+        if line_byte <= cursor_byte {
+            (cursor_row, cursor_col) = (row, column);
+        }
+
+        // Highlighting spans supply only styles. Segment the original line so
+        // a combining mark at a style boundary stays with its base character.
+        let mut spans = style_line(source).spans.into_iter();
+        let mut span_end = 0;
+        let mut style = Style::default();
+        for (offset, symbol) in source.grapheme_indices(true) {
+            while offset >= span_end {
+                let Some(span) = spans.next() else {
+                    span_end = source.len();
+                    break;
+                };
+                span_end += span.content.len();
+                style = span.style;
+            }
+
+            if symbol.contains(char::is_control) {
+                continue;
+            }
+            let cells = usize::from(symbol.cell_width());
+            if cells == 0 || cells > width {
+                continue;
+            }
+            if input.multiline && column + cells > width {
+                row += 1;
+                column = 0;
+            }
+
+            let byte = line_byte + offset;
+            if cursor_byte >= byte {
+                cursor_row = row;
+                cursor_col = if cursor_byte >= byte + symbol.len() {
+                    column + cells
+                } else {
+                    column
+                };
+            }
+            glyphs.push(EditorGlyph {
+                row,
+                column,
+                width: cells,
+                symbol,
+                style,
+            });
+            column += cells;
+        }
+        let line_end = line_byte + source.len();
+        if (line_byte..=line_end).contains(&cursor_byte) {
+            cursor_line_width = column;
+        }
+        line_byte = line_end + 1;
+        row += 1;
+    }
+
+    if input.multiline && cursor_col == width {
+        cursor_row += 1;
+        cursor_col = 0;
+    }
+    let first_row = cursor_row.saturating_sub(height - 1);
+    let mut first_col = if input.multiline {
+        0
+    } else {
+        let max_scroll = (cursor_line_width + 1).saturating_sub(width);
+        cursor_col.saturating_sub(width / 2).min(max_scroll)
+    };
+    // A horizontal viewport must start at a whole glyph.
+    if first_col > 0
+        && let Some(glyph) = glyphs.iter().find(|glyph| {
+            glyph.row == cursor_row
+                && glyph.column < first_col
+                && glyph.column + glyph.width > first_col
+        })
+    {
+        first_col = glyph.column + glyph.width;
+    }
 
+    let buffer = f.buffer_mut();
+    for glyph in glyphs {
+        if (first_row..first_row + height).contains(&glyph.row)
+            && glyph.column >= first_col
+            && glyph.column + glyph.width <= first_col + width
+        {
+            buffer.set_stringn(
+                area.x + (glyph.column - first_col) as u16,
+                area.y + (glyph.row - first_row) as u16,
+                glyph.symbol,
+                glyph.width,
+                glyph.style,
+            );
+        }
+    }
     f.set_cursor_position((
-        (text_area.x + ccol).min(text_area.x + width - 1),
-        text_area.y + (crow - scroll_y),
+        area.x + (cursor_col - first_col) as u16,
+        area.y + (cursor_row - first_row) as u16,
     ));
 }
 
