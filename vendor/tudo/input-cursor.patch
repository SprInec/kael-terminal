+fn title_caret_tracks_display_cells_and_scrolls_with_the_text() {
+    let dir = tempfile::tempdir().unwrap();
+    let mut app = App::new(Some(dir.path().to_path_buf())).unwrap();
+    app.add_list("Work".into());
+    app.start_add_task();
+    let title = "中e\u{301}👩\u{200d}💻X";
+    let Mode::Input(input) = &mut app.mode else {
+        panic!("expected task input")
+    };
+    input.buffer = title.to_owned();
+    input.end();
+    input.left();
+
+    let mut terminal = Terminal::new(TestBackend::new(40, 24)).unwrap();
+    terminal.draw(|f| ui::render(f, &mut app)).unwrap();
+    terminal.backend_mut().assert_cursor_position((13, 11));
+    assert_eq!(terminal.backend().buffer()[(13, 11)].symbol(), "X");
+
+    let Mode::Input(input) = &mut app.mode else {
+        unreachable!()
+    };
+    input.buffer = format!("中{}尾", "a".repeat(20));
+    input.end();
+    terminal.draw(|f| ui::render(f, &mut app)).unwrap();
+    terminal.backend_mut().assert_cursor_position((30, 11));
+    assert_eq!(terminal.backend().buffer()[(8, 11)].symbol(), "a");
+    assert_eq!(terminal.backend().buffer()[(28, 11)].symbol(), "尾");
+    assert_eq!(terminal.backend().buffer()[(30, 11)].symbol(), " ");
+
+    let Mode::Input(input) = &mut app.mode else {
+        unreachable!()
+    };
+    input.home();
+    terminal.draw(|f| ui::render(f, &mut app)).unwrap();
+    terminal.backend_mut().assert_cursor_position((8, 11));
+    assert_eq!(terminal.backend().buffer()[(8, 11)].symbol(), "中");
+
+    let Mode::Input(input) = &mut app.mode else {
+        unreachable!()
+    };
+    input.buffer = format!("{}中文{}", "a".repeat(30), "z".repeat(30));
+    input.cursor = 30;
+    terminal.draw(|f| ui::render(f, &mut app)).unwrap();
+    terminal.backend_mut().assert_cursor_position((20, 11));
+    assert_eq!(terminal.backend().buffer()[(20, 11)].symbol(), "中");
+    assert_eq!(terminal.backend().buffer()[(22, 11)].symbol(), "文");
+}
