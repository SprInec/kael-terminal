+#[test]
+fn multiline_caret_tracks_wrapped_text_and_scrolls_to_empty_lines() {
+    let dir = tempfile::tempdir().unwrap();
+    let mut app = App::new(Some(dir.path().to_path_buf())).unwrap();
+    for (field, width, height, x, y) in [
+        (InputField::Notes, 24, 8, 8, 8),
+        (InputField::NoteBody, 36, 19, 2, 2),
+    ] {
+        let prefix = "a".repeat(width - 1);
+        let buffer = format!("{prefix}中文X{}", "\n".repeat(height));
+        app.mode = Mode::Input(InputState {
+            field,
+            prompt: "Notes".into(),
+            buffer,
+            cursor: prefix.len() + 2,
+            multiline: true,
+            return_detail: false,
+        });
+        let mut terminal = Terminal::new(TestBackend::new(40, 24)).unwrap();
+        terminal.draw(|f| ui::render(f, &mut app)).unwrap();
+        terminal.backend_mut().assert_cursor_position((x + 4, y + 1));
+        let rendered = terminal.backend().buffer();
+        assert_eq!(rendered[(x + width as u16 - 1, y)].symbol(), " ");
+        assert_eq!(rendered[(x, y + 1)].symbol(), "中");
+        assert_eq!(rendered[(x + 4, y + 1)].symbol(), "X");
+
+        let Mode::Input(input) = &mut app.mode else {
+            unreachable!()
+        };
+        input.end();
+        terminal.draw(|f| ui::render(f, &mut app)).unwrap();
+        terminal.backend_mut().assert_cursor_position((x, y + height as u16 - 1));
+        assert_eq!(
+            terminal.backend().buffer()[(x, y + height as u16 - 1)].symbol(),
+            " "
+        );
+    }
+}
