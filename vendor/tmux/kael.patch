+		progress = window_pane_border_progress_init(wp, &glow, &percent);
+		glowing = !progress && window_pane_border_glow_init(wp, &glow);
+		count = (progress || glowing) ? width : 1;
+		for (i = 0; i < count; i++) {
+			memcpy(&cell, &gc, sizeof cell);
+			if (progress)
+				window_pane_border_progress_cell(&glow, percent,
