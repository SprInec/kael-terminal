+	u_int			 mask[REDRAW_FRAME_SIDES] = { 0 };
+	int			 wx, wy, mode, percent, progress, glowing, colour;
+	int			 have_edge = 0, frame_flags = 0;
+	u_int			 side, i, count;
+	size_t			 size = 64 + REDRAW_FRAME_SIDES * (4 + 8 * width);
+	char			*message, *p;
+
+	for (side = 0; side < REDRAW_FRAME_SIDES; side++) {
+		wp = data->frame[side].wp;
+		if (wp == NULL || (dctx->border_type == PANE_BORDER_TYPE_SEPARATE_ACTIVE &&
+		    wp != dctx->active))
+			continue;
+		lines = window_pane_get_pane_lines(wp);
+		if (lines == PANE_LINES_SPACES || lines == PANE_LINES_NONE)
+			continue;
+		if (lines != PANE_LINES_SINGLE && lines != PANE_LINES_ROUNDED)
+			return;
+		mask[side] = data->frame[side].mask;
+		if (window_pane_is_floating(wp)) {
+			frame_flags |= REDRAW_FRAME_FLOATING;
+			/* A clipped horizontal edge has no corner stem. */
+			if (data->type == REDRAW_SPAN_BORDER &&
+			    side != REDRAW_FRAME_VERTICAL &&
+			    !(data->b.cell_mask & (REDRAW_BORDER_U|REDRAW_BORDER_D)))
+				mask[side] = REDRAW_BORDER_L|REDRAW_BORDER_R;
+		}
+		have_edge = 1;
+	}
+	if (!have_edge)
+		return;
+
+	mode = 0; /* Replace the fallback box glyph. */
+	if (data->type == REDRAW_SPAN_STATUS)
+		mode = window_pane_get_pane_status(data->st.wp) ==
+		    PANE_STATUS_TOP ? 1 : 3; /* Top or bottom title. */
+	else if (data->b.flags & REDRAW_BORDER_IS_ARROW)
+		mode = 2; /* Keep the indicator. */
+
+	message = xmalloc(size);
+	p = message + xsnprintf(message, size, "\033]7757;%u;%u;%u;%d",
+	    x, y, width, mode | frame_flags);
+	wx = (int)x - (int)dctx->side_left + dctx->scene->ox;
+	wy = y + dctx->scene->oy;
+	if (dctx->flags & REDRAW_STATUS_TOP)
+		wy -= dctx->status_lines;
+
+	for (side = 0; side < REDRAW_FRAME_SIDES; side++) {
+		*p++ = ';';
+		if (mask[side] == 0)
+			continue;
+		p += xsnprintf(p, 4, "%x:", mask[side]);
+		wp = data->frame[side].wp;
+		window_pane_get_border_style(wp, c, &gc);
+		if (wp == dctx->marked)
