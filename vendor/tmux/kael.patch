+/* Redraw animated borders and drop stale foreground transfer reports. */
+static void
+server_border_glow_event(__unused int fd, __unused short events,
+    __unused void *data)
+{
+	struct client	*c;
+	struct window	*w;
+	struct window_pane *wp;
+	struct border_glow frame;
+	struct timeval	 tv = { .tv_sec = 1 };
+	static uint64_t	 last_check;
+	uint64_t	 now = get_timer();
+	int		 percent;
+
+	if (now - last_check >= 250) {
+		RB_FOREACH(wp, window_pane_tree, &all_window_panes) {
+			if (wp->transfer.progress != 0)
+				window_pane_transfer_refresh(wp);
+		}
+		last_check = now;
+	}
+	TAILQ_FOREACH(c, &clients, entry) {
+		if (c->session == NULL ||
+		    (c->flags & (CLIENT_CONTROL|CLIENT_UNATTACHEDFLAGS)) ||
+		    !(c->flags & CLIENT_TERMINAL) ||
+		    (c->tty.flags & TTY_BLOCK))
+			continue;
+		w = c->session->curw->window;
+		if (!window_pane_border_glow_init(w->active, &frame)) {
+			TAILQ_FOREACH(wp, &w->panes, entry) {
+				if (window_pane_border_progress_init(wp, &frame,
+				    &percent) && percent > 0)
+					break;
+			}
+			if (wp == NULL)
+				continue;
+		}
+		c->flags |= CLIENT_REDRAWBORDERS;
+		tv.tv_sec = 0;
+		tv.tv_usec = 50000;
+	}
+	evtimer_add(&server_ev_border_glow, &tv);
 }
 
