+
+static void
+window_pane_transfer_update(struct window_pane *wp, u_int progress)
+{
+	if (wp->transfer.progress == progress)
+		return;
+	wp->transfer.progress = progress;
+	if (wp->base.progress_bar.state == PROGRESS_BAR_HIDDEN) {
+		server_redraw_window_borders(wp->window);
+		server_status_window(wp->window);
+	}
+}
