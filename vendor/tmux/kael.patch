--- /dev/null
+++ b/border-glow.h
@@ -0,0 +1,202 @@
+/* Local border animation. Pure helpers shared with the geometry tests. */
+#ifndef BORDER_GLOW_H
+#define BORDER_GLOW_H
+#include <stdint.h>
+
+enum pane_border_notice {
+	PANE_BORDER_NOTICE_NONE,
+	PANE_BORDER_NOTICE_BUILD,
+	PANE_BORDER_NOTICE_DONE,
+	PANE_BORDER_NOTICE_FAIL,
+	PANE_BORDER_NOTICE_WARNING
+};
+
+#define PANE_BORDER_DONE_MS 1200
+#define PANE_BORDER_FAILED_MS 700
+#define PANE_BORDER_WARNING_MS 1000
+#define PANE_BORDER_BUILD_RGB 0x7ccbff
+
+struct border_glow {
+	int left, right, top, bottom;
+	unsigned int period;
+	uint64_t now;
+	int open_bottom;
+	int pulse_all;
+	int colour;
+	int show_base;
+	enum pane_border_notice notice;
+	uint64_t elapsed;
+};
+
+static inline int
+border_glow_length(const struct border_glow *g)
+{
+	int width = g->right - g->left, height = g->bottom - g->top;
+
+	if (g->open_bottom)
+		return (width + 2 * height + 1);
+	return (2 * (width + height));
+}
+
+/* Clockwise distance from the start of the border, or -1 off it. */
+static inline int
+border_glow_position(const struct border_glow *g, int x, int y)
+{
+	int width = g->right - g->left, height = g->bottom - g->top;
+
+	if (width <= 0 || height <= 0 || x < g->left || x > g->right ||
+	    y < g->top || y > g->bottom)
+		return (-1);
+	if (g->open_bottom) {
+		if (x == g->left)
+			return (g->bottom - y);
+		if (y == g->top)
+			return (height + x - g->left);
+		if (x == g->right)
+			return (height + width + y - g->top);
+		return (-1);
+	}
+	if (y == g->top)
+		return (x - g->left);
+	if (x == g->right)
+		return (width + y - g->top);
+	if (y == g->bottom)
+		return (width + height + g->right - x);
+	if (x == g->left)
+		return (2 * width + height + g->bottom - y);
+	return (-1);
+}
+
+/* Soft leading edge, longer fading tail, seamless across the first corner. */
+static inline double
+border_glow_strength(const struct border_glow *g, int position, int perimeter,
+    double tail, double lead)
+{
+	double head, distance, strength = 0;
+
+	head = (double)(g->now % g->period) * perimeter / g->period;
+	distance = head - position;
+	if (distance < 0)
+		distance += perimeter;
+	if (distance < tail)
+		strength = 1.0 - distance / tail;
+	else if (perimeter - distance < lead)
+		strength = 1.0 - (perimeter - distance) / lead;
+	return (strength * strength * (3.0 - 2.0 * strength));
+}
+
+static inline double
+border_glow_sweep(const struct border_glow *g, int position)
+{
+	int perimeter = border_glow_length(g);
+	double tail = perimeter * 0.20;
+
+	if (tail < 6)
+		tail = 6;
+	if (tail > 48)
+		tail = 48;
+	return (border_glow_strength(g, position, perimeter, tail, tail * 0.16));
+}
+
+static inline double
+border_glow_ease(double phase)
+{
+	return (phase * phase * (3.0 - 2.0 * phase));
+}
+
+static inline int
+border_scale_rgb(int rgb, double factor)
+{
+	int channel, result = 0;
+
+	for (channel = 0; channel < 24; channel += 8)
+		result |= (int)(((rgb >> channel) & 255) * factor + 0.5) << channel;
+	return (result);
+}
+
+static inline int
+border_glow_moves(const struct border_glow *g)
+{
+	if (g->notice == PANE_BORDER_NOTICE_FAIL)
+		return (g->elapsed < PANE_BORDER_FAILED_MS);
+	if (g->notice == PANE_BORDER_NOTICE_WARNING)
+		return (g->show_base || g->elapsed < PANE_BORDER_WARNING_MS + 100);
+	return (1);
+}
+
+static inline int
+border_glow_rgb(const struct border_glow *g, int x, int y, int rgb)
+{
+	int position = border_glow_position(g, x, y);
+	double strength;
+
+	if (position < 0 || g->period == 0)
+		return (rgb);
+	if (g->notice == PANE_BORDER_NOTICE_FAIL) {
+		strength = g->elapsed >= 600 || g->elapsed % 300 < 150 ? 1.0 : 0.38;
+		return (border_scale_rgb(rgb, strength));
+	}
+	if (g->notice == PANE_BORDER_NOTICE_DONE) {
+		strength = 2.0 * g->elapsed / PANE_BORDER_DONE_MS;
+		if (strength > 1.0)
+			strength = 2.0 - strength;
+		return (border_scale_rgb(rgb, 0.52 + 0.48 * border_glow_ease(strength)));
+	}
+	if (g->notice == PANE_BORDER_NOTICE_WARNING && y == g->top) {
+		strength = g->elapsed >= PANE_BORDER_WARNING_MS ? 0.0 :
+		    1.0 - (double)g->elapsed / PANE_BORDER_WARNING_MS;
+		return (border_scale_rgb(0xf3b849, 0.55 + 0.45 * border_glow_ease(strength)));
+	}
+	if (g->pulse_all) {
+		strength = 2.0 * (g->now % g->period) / g->period;
+		if (strength > 1.0)
+			strength = 2.0 - strength;
+		strength = border_glow_ease(strength);
+	} else
+		strength = border_glow_sweep(g, position);
+	return (border_scale_rgb(rgb, 0.52 + 0.48 * strength));
+}
+
+static inline int
+border_glow_title_rgb(const struct border_glow *g, int x, int y, int rgb,
+    int border_rgb)
+{
+	int position = border_glow_position(g, x, y);
+	int channel, base, peak, result = 0;
+	double strength;
+
+	if (position < 0 || g->period == 0)
+		return (rgb);
+	strength = border_glow_sweep(g, position);
+	for (channel = 0; channel < 24; channel += 8) {
+		base = (rgb >> channel) & 255;
+		peak = (border_rgb >> channel) & 255;
+		peak += (255 - peak) / 5;
+		result |= (int)(base + (peak - base) * strength + 0.5) << channel;
+	}
+	return (result);
+}
+
+/* Sweep a brighter blue over the fill at a phase independent of its length. */
+static inline int
+border_progress_rgb(const struct border_glow *g, int position, int perimeter)
+{
+	const int blue = 0x7aafff, highlight = 0xa9d6ff;
+	int channel, base, peak, result = 0;
+	double tail = perimeter * 0.12, strength;
+
+	if (g->period == 0)
+		return (blue);
+	if (tail < 6)
+		tail = 6;
+	if (tail > 32)
+		tail = 32;
+	strength = border_glow_strength(g, position, perimeter, tail, tail * 0.4);
+	for (channel = 0; channel < 24; channel += 8) {
+		base = (blue >> channel) & 255;
+		peak = (highlight >> channel) & 255;
+		result |= (int)(base + (peak - base) * strength + 0.5) << channel;
+	}
+	return (result);
+}
+#endif
