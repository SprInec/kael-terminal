+/* Collect a bounded line after the terminal parser has removed escapes. */
+void
+window_pane_transfer_print(struct window_pane *wp, int ch)
+{
+	if (wp->transfer.length >= sizeof wp->transfer.line)
+		return;
+	if (ch == '\b') {
+		if (wp->transfer.length != 0)
+			wp->transfer.length--;
+	} else
+		wp->transfer.line[wp->transfer.length++] = ch;
+	wp->transfer.dirty = 1;
+}
+
+static int
+window_pane_transfer_ratio(const char *start, const char **end)
+{
+	const char		*slash, *denominator;
+	char			*tail;
+	unsigned long long	 done, total;
+
+	if (!isdigit((u_char)*start))
+		return (-1);
+	done = strtoull(start, &tail, 10);
+	slash = tail + strspn(tail, " \t");
+	if (*slash != '/' || tail - start > 18)
+		return (-1);
+	denominator = slash + 1 + strspn(slash + 1, " \t");
+	if (!isdigit((u_char)*denominator))
+		return (-1);
+	total = strtoull(denominator, &tail, 10);
+	if (tail - denominator > 18 || total == 0 || done > total ||
+	    (*tail != '\0' && strchr(" \t)]|", *tail) == NULL))
+		return (-1);
+	*end = tail;
+	return ((int)(100.0L * done / total));
+}
+
+static int
+window_pane_transfer_percent(struct window_pane *wp, const char *line,
+    int *inline_progress)
+{
+	const char	*p, *first, *start, *end, *before, *suffix, *tail;
+	u_int		 total, received, sent;
+	int		 percent, labelled;
+
+	/* Some column meters identify percentages in their header. */
+	if (strstr(line, "% Total") != NULL &&
+	    strstr(line, "% Received") != NULL && strstr(line, "% Xferd") != NULL)
+		wp->transfer.column_meter = 1;
+	if (wp->transfer.column_meter &&
+	    sscanf(line, " %3u %*s %3u %*s %3u", &total, &received, &sent) == 3 &&
+	    total <= 100 && received <= 100 && sent <= 100)
+		return (total);
+
+	first = line + strspn(line, " \t");
+	labelled = strncasecmp(first, "progress:", 9) == 0;
+	for (p = first; (p = strchr(p, '%')) != NULL; p++) {
+		end = p;
+		while (end > first && isblank((u_char)end[-1]))
+			end--;
+		start = end;
+		while (start > first && isdigit((u_char)start[-1]))
+			start--;
+		if (start < end && start > first && start[-1] == '.') {
+			end = --start;
+			while (start > first && isdigit((u_char)start[-1]))
+				start--;
+		}
+		if (start == end || end - start > 3 ||
+		    (start > first && strchr(" \t[(|=:>", start[-1]) == NULL) ||
+		    (p[1] != '\0' && strchr(" \t])[(|", p[1]) == NULL))
+			continue;
+		percent = strtol(start, NULL, 10);
+		if (percent > 100)
+			continue;
+		before = start;
+		while (before > first && isblank((u_char)before[-1]))
+			before--;
+		suffix = p + 1 + strspn(p + 1, " \t");
+		/* Plain log percentages need redraw evidence or meter syntax. */
+		if (labelled || (*first == '[' && before == first + 1 &&
+		    *suffix == ']') || (*suffix == '(' &&
+		    window_pane_transfer_ratio(suffix + 1, &tail) >= 0 &&
+		    *tail == ')') || strstr(line, "..........") != NULL)
+			return (percent);
+		if (wp->transfer.rewritten) {
+			*inline_progress = 1;
+			return (percent);
+		}
+	}
+	if (!wp->transfer.rewritten && !labelled)
+		return (-1);
+	for (p = first; (p = strchr(p, '/')) != NULL; p++) {
+		start = p;
+		while (start > first && isblank((u_char)start[-1]))
+			start--;
+		while (start > first && isdigit((u_char)start[-1]))
+			start--;
+		if (start > first && strchr(" \t[(|=:", start[-1]) == NULL)
+			continue;
+		percent = window_pane_transfer_ratio(start, &tail);
+		if (percent >= 0 && tail > p) {
+			*inline_progress = !labelled;
+			return (percent);
+		}
+	}
+	return (-1);
+}
+
+void
+window_pane_transfer_report(struct window_pane *wp, int boundary)
+{
+	int percent = -1, inline_progress = 0;
+
+	if (wp->transfer.dirty &&
+	    wp->base.progress_bar.state == PROGRESS_BAR_HIDDEN) {
+		if (wp->transfer.length < sizeof wp->transfer.line) {
+			wp->transfer.line[wp->transfer.length] = '\0';
+			percent = window_pane_transfer_percent(wp, wp->transfer.line,
+			    &inline_progress);
+		}
+		/* More bytes can invalidate a token accepted at the end of a read. */
+		if (percent >= 0) {
+			wp->transfer.inline_progress = inline_progress;
+			window_pane_transfer_update(wp, percent + 1);
+		} else {
+			wp->transfer.inline_progress =
+			    wp->transfer.inline_progress_before_line;
+			window_pane_transfer_update(wp, wp->transfer.progress_before_line);
+		}
+	}
+	wp->transfer.dirty = 0;
+	if (boundary != 0) {
+		wp->transfer.length = 0;
+		wp->transfer.rewritten = (boundary != '\n');
+		/* Without an explicit meter, the status ends with its line. */
+		if (boundary == '\n' && (wp->transfer.inline_progress ||
+		    wp->transfer.progress == 101)) {
+			wp->transfer.inline_progress = 0;
+			window_pane_transfer_update(wp, 0);
+		}
+		wp->transfer.progress_before_line = wp->transfer.progress;
+		wp->transfer.inline_progress_before_line = wp->transfer.inline_progress;
+	}
+}
+
+struct progress_bar
+window_pane_progress_bar(struct window_pane *wp)
+{
+	struct progress_bar pb = wp->base.progress_bar;
+
+	if (pb.state == PROGRESS_BAR_HIDDEN && wp->transfer.progress != 0 &&
+	    window_pane_border_progress_enabled(wp)) {
+		pb.state = PROGRESS_BAR_NORMAL;
+		pb.progress = wp->transfer.progress - 1;
+	}
+	return (pb);
+}
