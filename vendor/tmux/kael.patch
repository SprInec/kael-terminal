+ * Annotate the cells just drawn with the two independent edges. Tabby keeps
+ * these on its buffer cells, so an overwrite clears the annotation. Other
+ * terminals use the ordinary box characters and title already written.
+ */
+static void
+redraw_send_frame(struct redraw_draw_ctx *dctx, struct redraw_span *span,
+    u_int x, u_int y, u_int width)
+{
+	struct client		*c = dctx->scene->c;
