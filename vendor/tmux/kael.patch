+		before = start;
+		while (before > first && isblank((u_char)before[-1]))
+			before--;
+		suffix = p + 1 + strspn(p + 1, " \t");
+		/* Plain log percentages need redraw evidence or meter syntax. */
+		if (labelled || (*first == '[' && before == first + 1 &&
+		    *suffix == ']') || (*suffix == '(' &&
+		    window_pane_transfer_ratio(suffix + 1, &tail) >= 0 &&
+		    *tail == ')') || strstr(line, "..........") != NULL)
+			return (percent);
+		if (wp->transfer.rewritten) {
+			*inline_progress = 1;
+			return (percent);
+		}
+	}
+	if (!wp->transfer.rewritten && !labelled)
+		return (-1);
+	for (p = first; (p = strchr(p, '/')) != NULL; p++) {
+		start = p;
+		while (start > first && isblank((u_char)start[-1]))
+			start--;
+		while (start > first && isdigit((u_char)start[-1]))
+			start--;
+		if (start > first && strchr(" \t[(|=:", start[-1]) == NULL)
+			continue;
+		percent = window_pane_transfer_ratio(start, &tail);
+		if (percent >= 0 && tail > p) {
+			*inline_progress = !labelled;
+			return (percent);
+		}
+	}
+	return (-1);
+}
+
+void
+window_pane_transfer_report(struct window_pane *wp, int boundary)
+{
+	int percent = -1, inline_progress = 0;
+
+	if (wp->transfer.dirty &&
+	    wp->base.progress_bar.state == PROGRESS_BAR_HIDDEN) {
+		if (wp->transfer.length < sizeof wp->transfer.line) {
+			wp->transfer.line[wp->transfer.length] = '\0';
+			percent = window_pane_transfer_percent(wp, wp->transfer.line,
+			    &inline_progress);
+		}
+		/* More bytes can invalidate a token accepted at the end of a read. */
+		if (percent >= 0) {
+			wp->transfer.inline_progress = inline_progress;
+			window_pane_transfer_update(wp, percent + 1);
+		} else {
+			wp->transfer.inline_progress =
+			    wp->transfer.inline_progress_before_line;
+			window_pane_transfer_update(wp, wp->transfer.progress_before_line);
+		}
+	}
+	wp->transfer.dirty = 0;
+	if (boundary != 0) {
+		wp->transfer.length = 0;
+		wp->transfer.rewritten = (boundary != '\n');
+		/* Without an explicit meter, the status ends with its line. */
+		if (boundary == '\n' && (wp->transfer.inline_progress ||
+		    wp->transfer.progress == 101)) {
+			wp->transfer.inline_progress = 0;
+			window_pane_transfer_update(wp, 0);
+		}
+		wp->transfer.progress_before_line = wp->transfer.progress;
+		wp->transfer.inline_progress_before_line = wp->transfer.inline_progress;
+	}
+}
+
+struct progress_bar
+window_pane_progress_bar(struct window_pane *wp)
+{
+	struct progress_bar pb = wp->base.progress_bar;
+
+	if (pb.state == PROGRESS_BAR_HIDDEN && wp->transfer.progress != 0 &&
+	    window_pane_border_progress_enabled(wp)) {
+		pb.state = PROGRESS_BAR_NORMAL;
+		pb.progress = wp->transfer.progress - 1;
+	}
+	return (pb);
+}
+
+/* Positions are shared by the focus animation and the transfer progress. */
+static int
+window_pane_border_frame(struct window_pane *wp, struct border_glow *glow)
+{
+	struct window *w = wp->window;
+	int scrollbar;
+
+	glow->left = (int)wp->xoff - 1;
+	glow->right = wp->xoff + wp->sx;
+	glow->top = (int)wp->yoff - 1;
+	glow->bottom = wp->yoff + wp->sy;
+	if (window_pane_scrollbar_visible(wp) &&
+	    !window_pane_scrollbar_overlay(wp)) {
+		scrollbar = wp->scrollbar_style.width + wp->scrollbar_style.pad;
+		if (w->sb_pos == PANE_SCROLLBARS_LEFT)
+			glow->left -= scrollbar;
+		else
+			glow->right += scrollbar;
+	}
+	if (window_pane_is_floating(wp)) {
+		if (glow->left < 0)
+			glow->left = 0;
+		if (glow->right >= (int)w->sx)
+			glow->right = w->sx - 1;
+		if (glow->top < 0)
+			glow->top = 0;
+		if (glow->bottom >= (int)w->sy)
+			glow->bottom = w->sy - 1;
+	}
+	return (glow->right > glow->left && glow->bottom > glow->top);
+}
+
+int
+window_pane_border_progress_init(struct window_pane *wp, struct border_glow *g,
+    int *percent)
+{
+	struct progress_bar pb;
+
+	if (wp == NULL || !window_pane_is_visible(wp) ||
+	    (wp->flags & (PANE_EXITED|PANE_DESTROYED)) ||
+	    !window_pane_border_progress_enabled(wp))
+		return (0);
+	pb = window_pane_progress_bar(wp);
+	if (pb.state == PROGRESS_BAR_HIDDEN)
+		return (0);
+	*percent = pb.state == PROGRESS_BAR_INDETERMINATE ? 0 : pb.progress;
+	g->period = 2400;
+	g->now = (get_timer() / 50) * 50;
+	return (window_pane_border_frame(wp, g));
+}
+
+void
+window_pane_border_progress_cell(const struct border_glow *g, int percent,
+    int x, int y, struct grid_cell *gc)
+{
+	int position = border_glow_position(g, x, y);
+	int perimeter = 2 * (g->right - g->left + g->bottom - g->top);
+
+	if (position < 0)
+		return;
+	/* The first straight cell starts the fill, so the corner closes the lap. */
+	position = position == 0 ? perimeter - 1 : position - 1;
+	if (position < (int64_t)perimeter * percent / 100)
+		gc->fg = COLOUR_FLAG_RGB | border_progress_rgb(g, position, perimeter);
+	else
+		gc->fg = COLOUR_FLAG_256 | 238;
+	gc->attr &= ~GRID_ATTR_REVERSE;
+}
+
+/* Only the active pane in a separate-border layout is animated. */
+int
+window_pane_border_glow_init(struct window_pane *wp, struct border_glow *glow)
+{
+	struct window	*w;
+	struct options	*oo;
+	const char	*value, *error;
+	long long	 period = 4000;
+	int		 percent;
+
+	if (wp == NULL)
+		return (0);
+	w = wp->window;
+	oo = w->options;
+	if (wp != w->active || !window_border_type_is_separate(w) ||
+	    !window_pane_is_visible(wp) ||
+	    options_get(oo, "@pane-border-glow") == NULL)
+		return (0);
+	if (window_pane_border_progress_init(wp, glow, &percent))
+		return (0);
+	value = options_get_string(oo, "@pane-border-glow");
+	if (strcmp(value, "on") != 0 && strcmp(value, "1") != 0)
+		return (0);
+	if (options_get(oo, "@pane-border-glow-period") != NULL) {
+		value = options_get_string(oo, "@pane-border-glow-period");
+		period = strtonum(value, 1000, 60000, &error);
+		if (error != NULL)
+			period = 4000;
+	}
+	glow->period = period;
+	glow->now = (get_timer() / 50) * 50;
+	return (window_pane_border_frame(wp, glow));
+}
+
+void
+window_pane_border_glow_cell(const struct border_glow *glow, int x, int y,
+    struct grid_cell *gc)
+{
+	int colour = gc->fg;
+
+	if (!(colour & COLOUR_FLAG_RGB)) {
+		if (colour == 8 || colour == 9)
+			colour = 0xb1e969;
+		else
+			colour = colour_256toRGB(colour & 255);
+	}
+	gc->fg = border_glow_rgb(glow, x, y, colour & 0xffffff) |
+	    COLOUR_FLAG_RGB;
+}
 
