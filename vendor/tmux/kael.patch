+/* Positions are shared by the focus animation and the transfer progress. */
+static int
+window_pane_border_frame(struct window_pane *wp, struct border_glow *glow)
+{
+	struct window *w = wp->window;
+	int scrollbar;
+
+	glow->left = (int)wp->xoff - 1;
+	glow->right = wp->xoff + wp->sx;
+	glow->top = (int)wp->yoff - 1;
+	glow->bottom = wp->yoff + wp->sy;
+	glow->open_bottom = 0;
+	if (window_pane_scrollbar_visible(wp) &&
+	    !window_pane_scrollbar_overlay(wp)) {
+		scrollbar = wp->scrollbar_style.width + wp->scrollbar_style.pad;
+		if (w->sb_pos == PANE_SCROLLBARS_LEFT)
+			glow->left -= scrollbar;
+		else
+			glow->right += scrollbar;
+	}
+	if (window_pane_is_floating(wp)) {
+		if (glow->left < 0)
+			glow->left = 0;
+		if (glow->right >= (int)w->sx)
+			glow->right = w->sx - 1;
+		if (glow->top < 0)
+			glow->top = 0;
+		if (glow->bottom >= (int)w->sy)
+			glow->bottom = w->sy - 1;
+	} else if (glow->bottom >= (int)w->sy && !window_border_has_bottom(w)) {
+		glow->open_bottom = 1;
+		glow->bottom = w->sy - 1;
+	}
+	return (glow->right > glow->left && glow->bottom > glow->top);
+}
+
+static int
+window_pane_border_marked(struct window_pane *wp)
+{
+	return (marked_pane.wp == wp && server_check_marked());
+}
+
+/* Notice timestamps are monotonic milliseconds from the reporting host. */
+static int
+window_pane_border_notice_age(const char *value, uint64_t now, uint64_t *age)
+{
+	const char *error;
+	long long stamp = strtonum(value, 0, INT64_MAX, &error);
+
+	if (error != NULL)
+		return (0);
+	*age = (uint64_t)stamp <= now ? now - (uint64_t)stamp : 0;
+	return (1);
+}
+
+static enum pane_border_notice
+window_pane_border_notice(struct window_pane *wp, uint64_t now, uint64_t *age,
+    int *percent)
+{
+	struct options *oo = wp->options;
+	const char *value, *last, *error;
+
+	if (options_get_only(oo, "@pane-task") != NULL) {
+		value = options_get_string(oo, "@pane-task");
+		if (strncmp(value, "build:", 6) == 0 &&
+		    (last = strrchr(value + 6, ':')) != NULL) {
+			*percent = strtonum(last + 1, -1, 100, &error);
+			if (error == NULL)
+				return (PANE_BORDER_NOTICE_BUILD);
+		}
+		if (strncmp(value, "fail:", 5) == 0 &&
+		    window_pane_border_notice_age(value + 5, now, age))
+			return (PANE_BORDER_NOTICE_FAIL);
+		if (strncmp(value, "done:", 5) == 0 &&
+		    window_pane_border_notice_age(value + 5, now, age) &&
+		    *age < PANE_BORDER_DONE_MS)
+			return (PANE_BORDER_NOTICE_DONE);
+	}
+	if (wp != wp->window->active &&
+	    options_get_only(oo, "@pane-task-warning") != NULL &&
+	    window_pane_border_notice_age(options_get_string(oo,
+	    "@pane-task-warning"), now, age))
+		return (PANE_BORDER_NOTICE_WARNING);
+	return (PANE_BORDER_NOTICE_NONE);
+}
+
+void
+window_pane_border_notice_tick(struct window_pane *wp, uint64_t now)
+{
+	struct options_entry *option;
+	const char *value;
+	uint64_t age;
+	int changed = 0;
+
+	option = options_get_only(wp->options, "@pane-task-warning");
+	if (option != NULL && wp == wp->window->active) {
+		options_remove_or_default(option, NULL, NULL);
+		changed = 1;
+	}
+	option = options_get_only(wp->options, "@pane-task");
+	if (option != NULL) {
+		value = options_get_string(wp->options, "@pane-task");
+		if (strncmp(value, "done:", 5) == 0 &&
+		    window_pane_border_notice_age(value + 5, now, &age) &&
+		    age >= PANE_BORDER_DONE_MS) {
+			options_remove_or_default(option, NULL, NULL);
+			changed = 1;
+		}
+	}
+	if (changed)
+		server_redraw_window_borders(wp->window);
+}
+
+static void
+window_pane_border_roles(struct window_pane *wp, uint64_t now)
+{
+	struct format_tree *ft;
+	char *expanded;
+
+	if (now < wp->border_role_check)
+		return;
+	wp->border_role_check = now + 250;
+	ft = format_create(NULL, NULL, FORMAT_PANE|wp->id, 0);
+	format_defaults(ft, NULL, NULL, NULL, wp);
+	expanded = format_expand(ft, "#{E:@pane-remote}");
+	wp->border_remote = format_true(expanded);
+	free(expanded);
+	expanded = format_expand(ft, "#{E:@pane-training}");
+	wp->border_training = format_true(expanded);
+	free(expanded);
+	format_free(ft);
+}
+
+int
+window_pane_border_progress_init(struct window_pane *wp, struct border_glow *g,
+    int *percent)
+{
+	struct progress_bar pb;
+	enum pane_border_notice notice;
+	uint64_t now, age = 0;
+
+	if (wp == NULL || !window_pane_is_visible(wp) ||
+	    (wp->flags & (PANE_EXITED|PANE_DESTROYED)) ||
+	    window_pane_border_marked(wp))
+		return (0);
+	now = get_timer();
+	notice = window_pane_border_notice(wp, now, &age, percent);
+	g->colour = -1;
+	if (notice == PANE_BORDER_NOTICE_BUILD && *percent >= 0)
+		g->colour = PANE_BORDER_BUILD_RGB;
+	else {
+		if ((notice != PANE_BORDER_NOTICE_NONE &&
+		    notice != PANE_BORDER_NOTICE_WARNING) ||
+		    !window_pane_border_progress_enabled(wp))
+			return (0);
+		pb = window_pane_progress_bar(wp);
+		if (pb.state == PROGRESS_BAR_HIDDEN)
+			return (0);
+		*percent = pb.state == PROGRESS_BAR_INDETERMINATE ? 0 : pb.progress;
+	}
+	g->period = 2400;
+	g->now = (now / 50) * 50;
+	return (window_pane_border_frame(wp, g));
+}
+
+void
+window_pane_border_progress_cell(const struct border_glow *g, int percent,
+    int x, int y, struct grid_cell *gc)
+{
+	int position = border_glow_position(g, x, y);
+	int perimeter = border_glow_length(g);
+
+	if (position < 0)
+		return;
+	/* The first straight cell starts the fill on a closed border. */
+	if (!g->open_bottom)
+		position = position == 0 ? perimeter - 1 : position - 1;
+	if (position < (int64_t)perimeter * percent / 100)
+		gc->fg = COLOUR_FLAG_RGB | (g->colour != -1 ? g->colour :
+		    border_progress_rgb(g, position, perimeter));
+	else
+		gc->fg = COLOUR_FLAG_256 | 238;
+	gc->attr &= ~GRID_ATTR_REVERSE;
+}
+
+/* Resolve the pane's animation mode and effect for the current focus. */
+int
+window_pane_border_glow_init(struct window_pane *wp, struct border_glow *glow)
+{
+	struct window	*w;
+	struct options	*oo;
+	const char	*value, *error;
+	long long	 period = 4000;
+	uint64_t	 now;
+	int		 percent, pulse_focused, marked, remote, training, active, enable;
+
+	if (wp == NULL)
+		return (0);
+	w = wp->window;
+	oo = wp->options;
+	active = wp == w->active;
+	if (!window_border_type_is_separate(w) || !window_pane_is_visible(wp) ||
+	    (!active && options_get_number(w->options, "pane-border-type") ==
+	    PANE_BORDER_TYPE_SEPARATE_ACTIVE))
+		return (0);
+	now = get_timer();
+	marked = window_pane_border_marked(wp);
+	value = options_get(oo, "@pane-border-glow") == NULL ? "off" :
+	    options_get_string(oo, "@pane-border-glow");
+	enable = strcmp(value, "off") != 0 && strcmp(value, "0") != 0;
+	if (enable && !marked)
+		window_pane_border_roles(wp, now);
+	remote = enable && !marked && wp->border_remote;
+	training = enable && !marked && !remote && wp->border_training;
+	pulse_focused = remote || training || strcmp(value, "pulse-focused") == 0 ||
+	    strcmp(value, "pulse") == 0;
+	if (window_pane_border_progress_init(wp, glow, &percent))
+		return (0);
+	glow->elapsed = 0;
+	glow->notice = marked ? PANE_BORDER_NOTICE_NONE :
+	    window_pane_border_notice(wp, now, &glow->elapsed, &percent);
+	glow->show_base = enable && (marked || remote || training ||
+	    strcmp(value, "always") == 0 || strcmp(value, "pulse-focused") == 0 ||
+	    (active && (pulse_focused || strcmp(value, "on") == 0 ||
+	    strcmp(value, "1") == 0)));
+	if (!glow->show_base && glow->notice == PANE_BORDER_NOTICE_NONE)
+		return (0);
+	if (options_get(oo, "@pane-border-glow-period") != NULL) {
+		value = options_get_string(oo, "@pane-border-glow-period");
+		period = strtonum(value, 1000, 60000, &error);
+		if (error != NULL)
+			period = 4000;
+	}
+	glow->pulse_all = marked || (pulse_focused && active);
+	glow->colour = -1;
+	if (marked)
+		glow->colour = COLOUR_FLAG_RGB | 0xff9f43;
+	else if (remote && options_get(oo, "@pane-remote-colour") != NULL)
+		glow->colour = colour_fromstring(options_get_string(oo,
+		    "@pane-remote-colour"));
+	else if (training) {
+		value = options_get(oo, "@kael-training-colour") != NULL ?
+		    "@kael-training-colour" : "@pane-training-colour";
+		glow->colour = options_get(oo, value) == NULL ?
+		    COLOUR_FLAG_RGB | 0xb69cff : colour_fromstring(options_get_string(oo, value));
+	}
+	switch (glow->notice) {
+	case PANE_BORDER_NOTICE_BUILD:
+		glow->colour = COLOUR_FLAG_RGB | PANE_BORDER_BUILD_RGB;
+		glow->show_base = 1;
+		glow->pulse_all = 0;
+		break;
+	case PANE_BORDER_NOTICE_FAIL:
+		glow->colour = COLOUR_FLAG_RGB | 0xff746c;
+		glow->pulse_all = 1;
+		break;
+	case PANE_BORDER_NOTICE_DONE:
+		glow->colour = COLOUR_FLAG_RGB | 0x85e6bd;
+		glow->pulse_all = 1;
+		break;
+	default:
+		break;
+	}
+	glow->period = period;
+	glow->now = (now / 50) * 50;
+	return (window_pane_border_frame(wp, glow));
+}
+
+void
+window_pane_border_glow_cell(const struct border_glow *glow, int x, int y,
+    struct grid_cell *gc)
+{
+	int colour = glow->colour == -1 ? gc->fg : glow->colour;
+
+	if (glow->notice == PANE_BORDER_NOTICE_WARNING && !glow->show_base &&
+	    y != glow->top)
+		return;
+	if (!(colour & COLOUR_FLAG_RGB)) {
+		if (colour == 8 || colour == 9)
+			colour = 0xb1e969;
+		else
