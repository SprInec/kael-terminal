+static int
+window_pane_border_progress_enabled(struct window_pane *wp)
+{
+	struct window *w = wp->window;
+	const char *value;
+
+	if (!window_border_type_is_separate(w) ||
+	    options_get(w->options, "@pane-border-progress") == NULL)
+		return (0);
+	value = options_get_string(w->options, "@pane-border-progress");
+	return (strcmp(value, "on") == 0 || strcmp(value, "1") == 0);
+}
+
+static void
+window_pane_transfer_update(struct window_pane *wp, u_int progress)
+{
+	if (wp->transfer.progress == progress)
+		return;
+	wp->transfer.progress = progress;
+	if (wp->base.progress_bar.state == PROGRESS_BAR_HIDDEN) {
+		server_redraw_window_borders(wp->window);
+		server_status_window(wp->window);
+	}
+}
+
+void
+window_pane_transfer_reset(struct window_pane *wp)
+{
+	pid_t pgid = wp->transfer.pgid;
+
+	window_pane_transfer_update(wp, 0);
+	memset(&wp->transfer, 0, sizeof wp->transfer);
+	wp->transfer.pgid = pgid;
+}
+
+/* Keep inferred progress tied to the foreground job. */
+int
+window_pane_transfer_refresh(struct window_pane *wp)
+{
+	pid_t pgid = -1;
+
+	if (wp->fd != -1 && !(wp->flags & (PANE_EXITED|PANE_DESTROYED)) &&
+	    !SCREEN_IS_ALTERNATE(&wp->base) &&
+	    window_pane_border_progress_enabled(wp))
+		pgid = tcgetpgrp(wp->fd);
+	if (wp->transfer.pgid != pgid) {
+		window_pane_transfer_reset(wp);
+		wp->transfer.pgid = pgid;
+	}
+	return (pgid > 0);
+}
+
+/* Collect a bounded line after the terminal parser has removed escapes. */
+void
+window_pane_transfer_print(struct window_pane *wp, int ch)
+{
+	if (wp->transfer.length >= sizeof wp->transfer.line)
+		return;
+	if (ch == '\b') {
+		if (wp->transfer.length != 0)
+			wp->transfer.length--;
+	} else
+		wp->transfer.line[wp->transfer.length++] = ch;
+	wp->transfer.dirty = 1;
+}
+
+static int
+window_pane_transfer_ratio(const char *start, const char **end)
+{
+	const char		*slash, *denominator;
+	char			*tail;
+	unsigned long long	 done, total;
+
+	if (!isdigit((u_char)*start))
+		return (-1);
+	done = strtoull(start, &tail, 10);
+	slash = tail + strspn(tail, " \t");
+	if (*slash != '/' || tail - start > 18)
+		return (-1);
+	denominator = slash + 1 + strspn(slash + 1, " \t");
+	if (!isdigit((u_char)*denominator))
+		return (-1);
+	total = strtoull(denominator, &tail, 10);
+	if (tail - denominator > 18 || total == 0 || done > total ||
+	    (*tail != '\0' && strchr(" \t)]|", *tail) == NULL))
+		return (-1);
+	*end = tail;
+	return ((int)(100.0L * done / total));
+}
+
+static int
+window_pane_transfer_percent(struct window_pane *wp, const char *line,
+    int *inline_progress)
