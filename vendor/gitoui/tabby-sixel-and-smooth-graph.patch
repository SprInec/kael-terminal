+#[cfg(unix)]
+fn direct_tabby() -> bool {
+    use std::env::var_os;
+
+    let term_program = var_os("TERM_PROGRAM");
+    !var_os("TMUX").is_some_and(|value| !value.is_empty())
+        && !term_program.as_ref().is_some_and(|name| name.eq_ignore_ascii_case("tmux"))
+        && (term_program.is_some_and(|name| name.eq_ignore_ascii_case("tabby"))
+            || var_os("TABBY_CONFIG_DIRECTORY").is_some_and(|value| !value.is_empty()))
+}
+
+#[cfg(unix)]
+fn read_tabby_cell_size() -> Option<(u16, u16)> {
+    use nix::poll::{poll, PollFd, PollFlags};
+    use nix::unistd::read;
+    use std::{
+        io::{self, Write},
+        os::fd::{AsFd, AsRawFd},
+        time::Instant,
+    };
+
+    let mut output = io::stdout().lock();
+    output.write_all(b"\x1b[16t").ok()?;
+    output.flush().ok()?;
+    drop(output);
+
+    let input = io::stdin();
+    let mut descriptors = [PollFd::new(input.as_fd(), PollFlags::POLLIN)];
+    let deadline = Instant::now() + PROBE_TIMEOUT;
+    let mut reply = Vec::new();
+    let mut buffer = [0; 64];
+    while reply.len() < 256 {
+        let timeout_ms = deadline.saturating_duration_since(Instant::now()).as_millis() as u16;
+        if timeout_ms == 0 || poll(&mut descriptors, timeout_ms).ok()? == 0 {
+            break;
+        }
+        let count = read(input.as_raw_fd(), &mut buffer).ok()?;
+        if count == 0 {
+            break;
+        }
+        reply.extend_from_slice(&buffer[..count]);
+        let report = parse_reply(&String::from_utf8_lossy(&reply));
+        if report.cell_px.is_some() {
+            return report.cell_px;
+        }
+    }
+    None
+}
