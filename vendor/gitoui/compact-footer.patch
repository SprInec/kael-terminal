+/// Render footer hints within `max` columns, including the styled dividers.
+/// Keep complete hints from the start and shorten the first if it alone is too wide.
+pub fn fit_hints(hint: &str, max: usize, separator_style: Style) -> Line<'_> {
+    const SEPARATOR: &str = " | ";
+    let mut parts = hint.split("▕▏");
+    let first = parts.next().unwrap_or_default();
+    let mut used = width(first);
+    if used > max {
+        return Line::from(ellipsize_end(first, max));
+    }
+
+    let separator_width = width(SEPARATOR);
+    let mut spans = vec![Span::raw(first)];
+    for part in parts {
+        let required = separator_width + width(part);
+        if required > max - used {
+            break;
+        }
+        spans.push(Span::styled(SEPARATOR, separator_style));
+        spans.push(Span::raw(part));
+        used += required;
+    }
+    Line::from(spans)
 }
 
