+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn edit_multibyte_input() {
+        let mut text = String::new();
+        let mut cursor = 0;
+        for code in [
+            KeyCode::Char('中'),
+            KeyCode::Char('文'),
+            KeyCode::Char('🙂'),
+            KeyCode::Left,
+            KeyCode::Backspace,
+            KeyCode::Char('字'),
+            KeyCode::Delete,
+        ] {
+            assert!(edit_input(
+                &mut text,
+                &mut cursor,
+                KeyEvent::new(code, KeyModifiers::NONE),
+            ));
+            assert!(text.is_char_boundary(cursor));
+        }
+        assert_eq!(text, "中字");
+        assert_eq!(cursor, text.len());
+    }
+
+    #[test]
+    fn edit_multibyte_words() {
+        let mut text = String::from("v1/中文/é");
+        let mut cursor = 0;
+        for code in [KeyCode::Right, KeyCode::Delete] {
+            assert!(edit_input(
+                &mut text,
+                &mut cursor,
+                KeyEvent::new(code, KeyModifiers::CONTROL),
+            ));
+            assert!(text.is_char_boundary(cursor));
+        }
+        assert_eq!(text, "v1/é");
+        assert_eq!(cursor, 2);
+    }
+
+    #[test]
+    fn cursor_columns_and_offsets_handle_wide_characters() {
+        assert_eq!(
