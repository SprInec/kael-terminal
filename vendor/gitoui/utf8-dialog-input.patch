+/// Handle keys shared by both dialog inputs. The cursor stays at a UTF-8
+/// character boundary so edits can use it as a byte offset.
+fn edit_input(text: &mut String, cursor: &mut usize, key: KeyEvent) -> bool {
+    let ctrl = key.modifiers.contains(KeyModifiers::CONTROL);
+    match key.code {
+        // Ctrl+H and Ctrl+W are also used by terminals for deleting a word.
+        KeyCode::Char('h' | 'w') | KeyCode::Backspace if ctrl => {
+            let start = word_left(text, *cursor);
+            text.drain(start..*cursor);
+            *cursor = start;
+        }
+        KeyCode::Char(c) => {
+            text.insert(*cursor, c);
+            *cursor += c.len_utf8();
+        }
+        KeyCode::Backspace => {
+            let start = prev_char_boundary(text, *cursor);
+            text.drain(start..*cursor);
+            *cursor = start;
+        }
+        KeyCode::Delete if ctrl => {
+            let end = word_right(text, *cursor);
+            text.drain(*cursor..end);
+        }
+        KeyCode::Delete => {
+            let end = next_char_boundary(text, *cursor);
+            text.drain(*cursor..end);
+        }
+        KeyCode::Left if ctrl => *cursor = word_left(text, *cursor),
+        KeyCode::Left => *cursor = prev_char_boundary(text, *cursor),
+        KeyCode::Right if ctrl => *cursor = word_right(text, *cursor),
+        KeyCode::Right => *cursor = next_char_boundary(text, *cursor),
+        KeyCode::Home => *cursor = 0,
+        KeyCode::End => *cursor = text.len(),
+        _ => return false,
+    }
+    true
+}
+
+fn prev_char_boundary(s: &str, cursor: usize) -> usize {
+    s[..cursor].char_indices().next_back().map_or(0, |(i, _)| i)
+}
+
+fn next_char_boundary(s: &str, cursor: usize) -> usize {
+    s[cursor..]
+        .chars()
+        .next()
+        .map_or(cursor, |c| cursor + c.len_utf8())
+}
+
